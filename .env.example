# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet/frontend is hosted (e.g., https://imagelab.pages.dev).
# Used for CORS allowlist and server-side self-referential links.
APP_URL="MY_APP_URL"

# CLOUDFLARE PAGES FRONTEND ENVIRONMENT VARIABLES (safe to expose in browser bundle)
# Point VITE_API_BASE_URL to your deployed Express backend URL (e.g., https://imagelab-api.onrender.com)
# Leave empty ("") for local full-stack development on the same origin.
VITE_API_BASE_URL=""
# Your Cloudflare Pages production URL used when generating dist/sitemap.xml & dist/robots.txt
VITE_SITE_URL="https://imagelab.pages.dev"

# FIREBASE CLIENT CONFIGURATION (firebase-applet-config.json is primary for imagelab-c612a)
# Optional non-secret reference values for imagelab-c612a.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="imagelab-c612a.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="imagelab-c612a"
VITE_FIREBASE_STORAGE_BUCKET="imagelab-c612a.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="44451093166"
VITE_FIREBASE_APP_ID="1:44451093166:web:8d0eca2c0e496fc618eb3f"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-imagelab-d8b60dbc-8777-4e03-bdda-b4f2c346fa02"

# FIREBASE SERVER ADMIN SDK & BACKEND CORS (server-side only — NEVER prefix with VITE_)
# Must belong to Firebase project "imagelab-c612a"
FIREBASE_PROJECT_ID="imagelab-c612a"
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-imagelab-d8b60dbc-8777-4e03-bdda-b4f2c346fa02"
FIREBASE_STORAGE_BUCKET="imagelab-c612a.firebasestorage.app"
FIREBASE_SERVICE_ACCOUNT_JSON=""
SUPER_ADMIN_EMAIL="adilwss67@gmail.com"
# Comma-separated production Cloudflare Pages / Workers / custom domain origins allowed to call the API
# Example: https://imagelab.pages.dev,https://*.imagelab.pages.dev,https://imagelab.yourdomain.com
ALLOWED_ORIGINS=""
PUBLIC_SITE_URL="https://imagelab.pages.dev"
